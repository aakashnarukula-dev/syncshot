rules_version = '2';

// SyncShot / ClipboardX realtime backend.
// Identity = email-link sign-in; every device signs in to the same account.
// All data lives under users/{uid} and is gated on the caller's auth uid.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
