rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function active(uid) {
      let access = get(/databases/$(database)/documents/entitlements/$(uid)).data;
      return access.lifetime == true || access.trialExpiresAt > request.time;
    }
    // Only Admin SDK / a verified payment webhook may write entitlements.
    match /entitlements/{uid} { allow read: if owner(uid); allow write: if false; }
    match /users/{uid}/{document=**} {
      allow read, create, update: if owner(uid) && active(uid);
      allow delete: if owner(uid);
    }
  }
}
