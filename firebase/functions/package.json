{
  "name": "functions",
  "description": "SyncShot / ClipboardX realtime backend \u2014 library + device pairing Cloud Functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
