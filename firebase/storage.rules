rules_version = '2';

// Screenshot blobs are stored under users/{uid}/... and gated on the caller's
// auth uid (email-link sign-in; all devices share the account).
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
